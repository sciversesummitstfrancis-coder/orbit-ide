{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORBIT IDE",
  "version": "0.1.0",
  "identifier": "dev.orbit.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "title": "ORBIT IDE",
        "width": 520,
        "height": 320,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true
      },
      {
        "label": "main",
        "url": "index.html",
        "title": "ORBIT IDE",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "shortDescription": "Your code. Your environment. Your orbit.",
    "longDescription": "ORBIT IDE is a lightweight, cross-platform desktop code editor built with Tauri 2, React, and Monaco.",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://github.com/sciversesummitstfrancis-coder/orbit-ide/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFQzdCQ0ZEOEZGOTUyRjEKUldUeFV2bVAvYnpIL2c1UHpFdXBMZ0NWL2dTK3dvSGxYaUlzK0gzQjMvUnNiVFhnanNwd3JiMzIK"
    }
  }
}
